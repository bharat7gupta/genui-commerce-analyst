              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "description": "Baseline [start, end) period; the reference period against which target is compared."
          },
          "target": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
