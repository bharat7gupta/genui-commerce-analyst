              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Exclusive end date, YYYY-MM-DD. Full month: first day of the following month."
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "description": "Target [start, end) period; change is target minus baseline."
